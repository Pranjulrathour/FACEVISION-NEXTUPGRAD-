# DATABASE
DATABASE_URL=postgresql+psycopg2://facevision:facevision@localhost:5432/facevision

# SERVER
HOST=0.0.0.0
PORT=8000
RELOAD=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# SECURITY (optional — unset disables both; see README "Security & rate limiting")
# API_KEY=
# DETECTIONS_RATE_LIMIT_PER_MIN=30
# GALLERY_ENROLL_RATE_LIMIT_PER_MIN=20
# GALLERY_RECOGNIZE_RATE_LIMIT_PER_MIN=60
# AUTH_RATE_LIMIT_PER_MIN=10

# AUTH (JWT_SECRET falls back to a random per-process value if unset — fine for local dev,
# but must be set to a real secret before deploying anywhere public; see README)
# JWT_SECRET=
# JWT_EXPIRE_MINUTES=10080

# RETENTION (optional — unset disables automatic purging; see docs/privacy-retention-policy.md)
# RETENTION_DAYS=90
