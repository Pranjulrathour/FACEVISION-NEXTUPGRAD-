# DATABASE
DATABASE_URL=postgresql+psycopg2://facevision:facevision@localhost:5432/facevision

# SERVER
HOST=0.0.0.0
PORT=8000
RELOAD=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# SECURITY (optional — unset disables both; see README "Security & rate limiting")
# API_KEY=
# DETECTIONS_RATE_LIMIT_PER_MIN=30
# COMPARE_RATE_LIMIT_PER_MIN=30

# RETENTION (optional — unset disables automatic purging; see docs/privacy-retention-policy.md)
# RETENTION_DAYS=90
